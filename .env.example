# =========================================================================
# LLM Provider (choose ONE - all have free tiers)
# =========================================================================
# Set LLM_PROVIDER to: "gemini", "groq", "deepseek", or "anthropic"
# If not set, auto-detects based on which API key is present.
LLM_PROVIDER=gemini

# Option 1: Google Gemini (RECOMMENDED - truly free, no credit card)
# Get key: https://aistudio.google.com/apikey
# Free: 250 requests/day, 1M context window
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq + Llama 3.3 70B (free, blazing fast 750+ tok/sec)
# Get key: https://console.groq.com
# Free: 1000 requests/day on 70B models
GROQ_API_KEY=your_groq_api_key_here

# Option 3: DeepSeek R1/V3 (10M free tokens, best for math/reasoning)
# Get key: https://platform.deepseek.com
# Free: 10M tokens on signup, then $0.28/1M tokens
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Option 4: Anthropic Claude (paid, best quality)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =========================================================================
# WhatsApp (optional)
# =========================================================================
WHATSAPP_TOKEN=your_whatsapp_business_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# =========================================================================
# Database (defaults work for hackathon)
# =========================================================================
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./data/money_mentor.db
